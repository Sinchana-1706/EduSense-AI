# EduSense AI Environment Configuration Example

# FastAPI Backend Settings
APP_NAME="EduSense AI Backend"
ENVIRONMENT="development"
HOST="127.0.0.1"
PORT=8000
DEBUG=True

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edusense_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edusense_db

# Real-Time Classroom Analytics (LiveKit Setup Placeholder)
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
